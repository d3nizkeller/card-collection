{
  "rules": {
    ".read": false,
    ".write": false,

    "nexus-rooms": {
      ".read": true,
      "$room": {
        ".write": true,
        ".validate": "newData.hasChildren()",
        "auth": {
          ".write": true,
          "login": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "hash": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "salt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "at": { ".validate": "newData.isNumber()" },
          "srv": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "nexus-jackpot-v3": {
      ".read": true,
      ".write": false,
      "jp": { ".read": true, ".write": false },
      "jpc": { ".read": true, ".write": false },
      "mk": { ".read": true, ".write": false },
      "st": {
        ".read": true,
        ".write": false,
        "p": { ".write": false, "$cid": { ".write": false, "bal": { ".write": false } } },
        "b": { ".write": false },
        "z": { ".write": false }
      }
    },

    "nexus-jackpot-v4": { ".read": true, ".write": false },
    "nexus-jackpot-v5": { ".read": true, ".write": false }
  }
}
